{
  "manifest_version": 3,
  "name": "C109 SNS Comment Extractor",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.tiktok.com/*"],
      "js": ["content_script.js"]
    }
  ]
}